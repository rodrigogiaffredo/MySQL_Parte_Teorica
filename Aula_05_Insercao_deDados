# Após executar o comando via ctrl + enter (ou clicando em 'Go'), mesmo com o status de comando bem sucedido, 
# usei o comando SELECT com asterisco (que significa 'tudo') para ver como a tabela ficou.

# SELECT * FROM pessoas;

# Inserção de novo registro:

# ('Maria', '1999-12-30', 'F', '55.2', '1.65', 'Portugal')

# Inserção de novo registro exercitando a constraint DEFAULT onde cabível (campos 'id', o qual é AUTO_COMPLETE
# e 'nacionalidade', o qual usa o dado DEFALUT 'Brasil'):

# INSERT INTO pessoas
# (id, nome, nascimento, sexo, peso, altura, nacionalidade)
# VALUES
# (DEFAULT, 'Creuza', '1920-01-02', 'F', '50.2', '1.83', DEFAULT);

# Ao executar, vemos a criação correta do id '3' (sequência), e a inserção do dado 'Brasil' no campo
# nacionalidade (dado definido como DEFAULT na criação da tabela).

# Exercitando o comando INSET sem menção dos campos do banco de dados, já que os dados serão informados 
# exatamente na ordem em que os campos da tabela foram estruturados:

# INSERT INTO pessoas VALUES
# (DEFAULT, 'Adalgiza', '1930-11-02', 'F', '63.2', '1.75', 'Irlanda');

# Exercitando a inserção de diversos registros simultâneamente, usando comando simplificado por respeitar aba
# ordem dos campos na estrutura da tabela:

# INSERT INTO pessoas VALUES
# (DEFAULT, 'Claudio', '1975-04-22', 'M', '99.0', '2.15', 'Brasil'),
